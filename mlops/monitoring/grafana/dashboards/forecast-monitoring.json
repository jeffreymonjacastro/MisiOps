    {
      "id": 6,
      "type": "timeseries",
      "title": "MAE by cutoff (PEN)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "misiops-${env}"
      },
      "description": "Mean absolute error of settled forecasts, published once outcomes mature (7 days after month end).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "misiops-${env}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "MisiOps/Forecast/${env}",
          "metricName": "MeanAbsoluteErrorPEN",
          "dimensions": {
            "Cutoff": [
              "*"
            ]
          },
          "statistic": "Maximum",
          "period": "3600",
          "region": "default",
          "matchExact": true,
          "id": "",
          "expression": "",
          "label": "${PROP('Dim.Cutoff')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyPEN",
          "noValue": "No settled outcomes in range",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Drift and retraining flags",
      "datasource": {
        "type": "cloudwatch",
        "uid": "misiops-${env}"
      },
      "description": "Hourly Maximum of each flag (0 or 1); the monitor reports once a day.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
