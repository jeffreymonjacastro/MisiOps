        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "misiops-${env}"
          },
          "queryMode": "Logs",
          "logGroupNames": [
            "/misiops/${env}/forecast-monitor"
          ],
          "expression": "fields @timestamp, model_version, labels_finalized, by_cutoff.early.decision, by_cutoff.early.observations, by_cutoff.early.settled_observations, by_cutoff.middle.decision, by_cutoff.middle.observations, by_cutoff.middle.settled_observations, by_cutoff.late.decision, by_cutoff.late.observations, by_cutoff.late.settled_observations\n| filter event = \"forecast_monitor\"\n| sort @timestamp desc\n| limit 20",
          "region": "default",
          "statsGroups": []
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "noValue": "No report in range"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "@timestamp": "time",
              "model_version": "model",
              "labels_finalized": "labels finalized",
              "by_cutoff.early.decision": "early decision",
              "by_cutoff.early.observations": "early obs",
              "by_cutoff.early.settled_observations": "early settled",
              "by_cutoff.middle.decision": "middle decision",
              "by_cutoff.middle.observations": "middle obs",
              "by_cutoff.middle.settled_observations": "middle settled",
              "by_cutoff.late.decision": "late decision",
              "by_cutoff.late.observations": "late obs",
              "by_cutoff.late.settled_observations": "late settled"
            },
            "excludeByName": {
              "__log__grafana_internal__": true,
              "__logstream__grafana_internal__": true
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Feature drift (PSI) - ${cutoff}",
      "description": "PSI per feature and for the prediction against the training reference; 0.25 or more triggers investigate_drift. Empty with insufficient_sample.",
