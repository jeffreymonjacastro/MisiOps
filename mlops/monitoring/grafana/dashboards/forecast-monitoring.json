    {
      "id": 8,
      "type": "table",
      "title": "Monitor reports (last 20)",
      "description": "Aggregate forecast_monitor reports from CloudWatch Logs: decision and sample sizes per cutoff.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "misiops-${env}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
