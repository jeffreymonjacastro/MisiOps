{
  "uid": "misiops-forecast-monitoring",
  "title": "MisiOps - Forecast monitoring",
  "tags": [
    "misiops",
    "mlops",
    "forecast"
  ],
  "timezone": "America/Lima",
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "dev,prod",
        "hide": 0,
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      },
      {
        "name": "cutoff",
        "label": "Cutoff",
        "type": "custom",
        "query": "early,middle,late",
        "hide": 0,
        "current": {
          "text": "early",
          "value": "early"
        },
        "options": [
          {
            "text": "early",
            "value": "early",
            "selected": true
          },
          {
            "text": "middle",
            "value": "middle",
            "selected": false
          },
          {
            "text": "late",
            "value": "late",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Daily forecast monitor for **${env}** (EventBridge, 07:25 Lima). Drift is the PSI against the training reference (alert at 0.25). Retraining is recommended when the settled MAE exceeds 1.30 x the release MAE. Fewer than 30 observations per cutoff gives `insufficient_sample`. Empty panels mean the monitor has not reported in the selected range."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Drift alarm (last hour)",
      "description": "Mirrors the CloudWatch alarm: Maximum of the flag over the last hour; 1 or more is ALARM, missing data is OK.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "misiops-${env}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "misiops-${env}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "MisiOps/Forecast/${env}",
          "metricName": "DriftDetected",
          "dimensions": {},
          "statistic": "Maximum",
          "period": "3600",
          "region": "default",
          "matchExact": true,
          "id": "",
          "expression": "",
          "label": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "OK (no data)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "ALARM",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "timeFrom": "1h"
    },
