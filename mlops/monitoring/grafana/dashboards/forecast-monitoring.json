              "by_cutoff.early.input_drift.days_remaining": "days_remaining",
              "by_cutoff.early.input_drift.prior_net_mean": "prior_net_mean",
              "by_cutoff.early.input_drift.prior_net_std": "prior_net_std",
              "by_cutoff.early.input_drift.prior_income_mean": "prior_income_mean",
              "by_cutoff.early.input_drift.prior_expense_mean": "prior_expense_mean",
              "by_cutoff.early.input_drift.historical_remaining": "historical_remaining",
              "by_cutoff.early.input_drift.month_day_fraction": "month_day_fraction",
              "by_cutoff.early.input_drift.bonus_month": "bonus_month",
              "by_cutoff.middle.decision": "decision",
              "by_cutoff.middle.prediction_drift": "prediction",
              "by_cutoff.middle.input_drift.income_mtd": "income_mtd",
              "by_cutoff.middle.input_drift.expense_mtd": "expense_mtd",
              "by_cutoff.middle.input_drift.derived_net": "derived_net",
              "by_cutoff.middle.input_drift.expense_last_7d": "expense_last_7d",
              "by_cutoff.middle.input_drift.days_remaining": "days_remaining",
