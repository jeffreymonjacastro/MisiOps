# Copy to mlops/monitoring/.env (git-ignored) and fill in. Never commit real values.
# Admin sign-in for the local Grafana. Viewers need no sign-in.
GRAFANA_ADMIN_PASSWORD=change-me
# ForecastDashboardRoleArn output of each stack. An unset prod role fails its health check.
GRAFANA_DEV_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-MisiOps-dev-ForecastDashboardRoleArn
GRAFANA_PROD_ROLE_ARN=
# Local AWS CLI profile and folder used only to assume the read-only roles.
AWS_PROFILE=default
AWS_DIR=~/.aws
# Host port, bound to 127.0.0.1 only.
GRAFANA_PORT=3001
