4" height="44" as="geometry"/></mxCell><mxCell id="m45" value="T8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=9;fillColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="628" width="22" height="22" as="geometry"/></mxCell><mxCell id="m46" value="T" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="735" width="44" height="44" as="geometry"/></mxCell><mxCell id="m47" value="T4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=9;fillColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="763" width="22" height="22" as="geometry"/></mxCell><mxCell id="m48" value="E" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="655" y="735" width="44" height="44" as="geometry"/></mxCell><mxCell id="m49" value="T11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=9;fillColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="685" y="763" width="22" height="22" as="geometry"/></mxCell><mxCell id="m50" value="E" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="600" width="44" height="44" as="geometry"/></mxCell><mxCell id="m51" value="T12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=9;fillColor=#000000;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="628" width="22" height="22" as="geometry"/></mxCell><mxCell id="m52" value="&lt;b&gt;Amenazas (riesgo = probabilidad × impacto)&lt;/b&gt;&lt;br&gt;&lt;b&gt;T1&lt;/b&gt; [S] Fuerza bruta / credential stuffing en login sin rate limiting — 15&lt;br&gt;&lt;b&gt;T2&lt;/b&gt; [S] Falsificación o robo de JWT de sesión — 16&lt;br&gt;&lt;b&gt;T3&lt;/b&gt; [T] Manipulación en tránsito por falta de TLS — 12&lt;br&gt;&lt;b&gt;T4&lt;/b&gt; [T] Cadena de suministro: dependencias e imágenes base — 20&lt;br&gt;&lt;b&gt;T5&lt;/b&gt; [T] XSS almacenado en datos de transacciones — 12&lt;br&gt;&lt;b&gt;T6&lt;/b&gt; [R] Sin bitácora de auditoría de cambios financieros — 12&lt;br&gt;&lt;b&gt;T7&lt;/b&gt; [I] Acceso a objetos de otro usuario (IDOR) — 12&lt;br&gt;&lt;b&gt;T8&lt;/b&gt; [I] Exposición de secretos en el repositorio — 20&lt;br&gt;&lt;b&gt;T9&lt;/b&gt; [I] Exfiltración desde PostgreSQL — 12&lt;br&gt;&lt;b&gt;T10&lt;/b&gt; [D] Agotamiento de CPU vía hashing en login — 8&lt;br&gt;&lt;b&gt;T11&lt;/b&gt; [E] Elevación vía pipeline o permisos de repositorio — 12&lt;br&gt;&lt;b&gt;T12&lt;/b&gt; [E] Panel de vulnerabilidades expuesto con credenciales por defecto — 12" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#666666;fillColor=#f5f5f5;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="70" width="360" height="230" as="geometry"/></mxCell><mxCell id="m53" value="&lt;b&gt;Leyenda:&lt;/b&gt; elipse = proceso · cilindro = almacén de datos · rectángulo = entidad externa · figura = actor humano · línea punteada roja = trust boundary · círculo amarillo = categoría STRIDE (S/T/R/I/D/E) con el ID de la amenaza en negro" style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1210" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>